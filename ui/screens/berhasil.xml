<screen permanent="true">
	<styles>
		<style
			name="style_ok_root"
			bg_color="#color_dark_bg"
			bg_opa="100%"
			text_color="#color_dark_text"
			pad_all="0"
			pad_gap="0"
		/>
		<style name="style_ok_content" pad_hor="20" pad_ver="16" />
		<style
			name="style_ok_circle"
			bg_color="#color_accent"
			bg_opa="20%"
			radius="100%"
			width="100"
			height="100"
			flex_main_place="center"
			flex_cross_place="center"
			pad_all="0"
			border_width="0"
			outline_width="0"
			shadow_width="0"
		/>
		<style name="style_ok_icon" image_recolor="#color_accent" image_recolor_opa="100%" width="60" height="60" />
		<style
			name="style_ok_title"
			text_color="#color_accent"
			text_font="font_inter_semi_bold_24"
			text_align="center"
		/>
		<style
			name="style_ok_id_card"
			bg_color="#color_dark_panel"
			bg_opa="100%"
			radius="#radius_default"
			border_width="0"
			outline_width="0"
			shadow_width="0"
		/>
		<style name="style_ok_id_label" text_color="#color_text_secondary" text_font="font_inter_regular_12" />
		<style name="style_ok_id_value" text_color="#color_dark_text" text_font="font_inter_semi_bold_20" />
		<style
			name="style_ok_hint"
			bg_color="#color_dark_panel"
			bg_opa="100%"
			radius="#radius_default"
			pad_all="12"
			border_width="0"
			outline_width="0"
			shadow_width="0"
		/>
		<style
			name="style_ok_hint_text"
			text_color="#color_text_on_card"
			text_font="font_inter_regular_13"
			text_align="center"
		/>
		<style name="style_ok_hint_accent" text_color="#color_accent" text_font="font_inter_semi_bold_13" />
	</styles>

	<view extends="lv_obj" width="480" height="480" flex_flow="column" scrollable="false">
		<style name="style_ok_root" />

		<status_bar width="480" height="48" />

		<column
			name="content"
			width="100%"
			height="361"
			gap="32"
			pad="0"
			horizontal_align="center"
			vertical_align="center"
			scrollable="false"
		>
			<style name="style_ok_content" />

			<lv_obj width="100" height="100" scrollable="false">
				<style name="style_ok_circle" />

				<!-- Icon: Gunakan align="center" (bukan inner_align) -->
				<lv_image src="icon_rfid_scan" width="60" height="60" align="center">
					<style name="style_ok_icon" />
				</lv_image>
			</lv_obj>

			<column width="100%" gap="12" pad="0" horizontal_align="center">
				<lv_label text="Scan Berhasil!" width="100%">
					<style name="style_ok_title" />
				</lv_label>

				<row
					width="212"
					gap="12"
					style_pad_hor="16"
					style_pad_ver="8"
					horizontal_align="center"
					vertical_align="center"
				>
					<style name="style_ok_id_card" />
					<lv_label text="ID Pasien:">
						<style name="style_ok_id_label" />
					</lv_label>
					<lv_label name="patient_id" text="-">
						<style name="style_ok_id_value" />
					</lv_label>
				</row>
			</column>

			<lv_obj
				flex_flow="row"
				width="content"
				height="content"
				style_flex_main_place="center"
				style_flex_cross_place="center"
				scrollable="false"
			>
				<style name="style_ok_hint" />
				<lv_spangroup width="content" style_text_align="center">
					<lv_spangroup-span text="Tekan " style="style_ok_hint_text" />
					<lv_spangroup-span text="START" style="style_ok_hint_accent" />
					<lv_spangroup-span text=" untuk mulai pengukuran" style="style_ok_hint_text" />
				</lv_spangroup>
			</lv_obj>
		</column>

		<button_bar
			width="480"
			height="71"
			label0="Start"
			icon0="icon_play"
			label1="Restart"
			icon1="icon_refresh"
			label2="Power"
			icon2="icon_power"
			color2="#color_danger"
			label3="Menu"
			icon3="icon_menu"
		/>
	</view>
</screen>
