<screen permanent="true">
	<styles>
		<style
			name="style_result_root"
			bg_color="#color_dark_bg"
			bg_opa="100%"
			text_color="#color_dark_text"
			pad_all="0"
			pad_gap="0"
		/>
		<style name="style_result_content" pad_hor="20" pad_ver="0" pad_gap="16" />
		<style
			name="style_result_banner"
			width="440"
			height="225"
			bg_color="#color_danger"
			bg_opa="100%"
			radius="#radius_default"
			pad_hor="16"
			pad_ver="44"
			pad_gap="12"
			flex_main_place="center"
			flex_cross_place="center"
			border_width="0"
			outline_width="0"
			shadow_width="0"
			text_color="#color_dark_text"
		/>
		<style
			name="style_warn_circle"
			bg_color="#color_dark_text"
			bg_opa="100%"
			radius="100%"
			width="64"
			height="64"
			pad_all="0"
			border_width="0"
			outline_width="0"
			shadow_width="0"
		/>
		<style name="style_warn_icon" image_recolor="#color_danger" image_recolor_opa="100%" width="28" height="28" />
		<style
			name="style_result_label"
			text_font="font_inter_bold_24"
			text_color="#color_dark_text"
			text_align="center"
		/>
		<style
			name="style_id_pill"
			bg_opa="30%"
			bg_color="#color_dark_bg"
			radius="100"
			pad_hor="12"
			pad_ver="4"
			text_color="#color_dark_text"
			text_font="font_inter_semi_bold_14"
			border_width="0"
			outline_width="0"
			shadow_width="0"
		/>
	</styles>

	<view extends="lv_obj" width="480" height="480" flex_flow="column" scrollable="false">
		<style name="style_result_root" />

		<status_bar width="480" height="48" />

		<column
			name="content"
			width="100%"
			height="361"
			gap="16"
			pad="20"
			style_flex_main_place="center"
			style_flex_cross_place="center"
			scrollable="false"
		>
			<style name="style_result_content" />

			<!-- Default RED state. Runtime switches result_banner, priority_icon and
                 priority_label together for YELLOW/GREEN; names are stable bindings. -->
			<lv_obj name="result_banner" flex_flow="column" width="100%" height="225" scrollable="false">
				<style name="style_result_banner" />

				<lv_obj name="priority_badge" width="64" height="64" scrollable="false">
					<style name="style_warn_circle" />
					<lv_image name="priority_icon" src="icon_priority_immediate" width="28" height="28" align="center">
						<style name="style_warn_icon" />
					</lv_image>
				</lv_obj>

				<lv_label name="priority_label" text="MERAH - IMMEDIATE" width="100%">
					<style name="style_result_label" />
				</lv_label>

				<lv_obj
					flex_flow="row"
					width="content"
					height="content"
					style_flex_main_place="center"
					style_flex_cross_place="center"
					scrollable="false"
				>
					<style name="style_id_pill" />
					<lv_label name="patient_id" text="ID Pasien: -" />
				</lv_obj>
			</lv_obj>

			<row width="440" gap="8" pad="0" style_flex_main_place="center" style_flex_cross_place="center">
				<result_vital
					name="vc_spo2"
					icon="icon_vital_spo2_sm"
					icon_color="#color_vital_spo2"
					caption="SpO2 %"
					value="--"
				/>
				<result_vital
					name="vc_hr"
					icon="icon_vital_hr_sm"
					icon_color="#color_vital_hr"
					caption="HR bpm"
					value="--"
				/>
				<result_vital
					name="vc_rr"
					icon="icon_vital_rr_sm"
					icon_color="#color_vital_rr"
					caption="RR /min"
					value="--"
				/>
				<result_vital
					name="vc_bp"
					icon="icon_vital_bp_sm"
					icon_color="#color_vital_bp"
					caption="BP mmHg"
					value="--/--"
				/>
			</row>
		</column>

		<button_bar
			width="480"
			height="71"
			label0="Monitor"
			icon0="icon_monitor"
			label1="Reset"
			icon1="icon_refresh"
			label2="Power"
			icon2="icon_power"
			color2="#color_danger"
			label3="Menu"
			icon3="icon_menu"
		/>
	</view>
</screen>
