<screen permanent="true">
	<styles>
		<style
			name="style_home_root"
			bg_color="#color_dark_bg"
			bg_opa="100%"
			text_color="#color_dark_text"
			pad_all="0"
			pad_gap="0"
		/>
		<style name="style_home_content" pad_hor="40" pad_ver="0" />
		<style name="style_home_logo" width="249" height="58" />
		<style
			name="style_home_subtitle"
			text_color="#color_accent"
			text_font="font_inter_semi_bold_18"
			text_align="center"
		/>
		<style
			name="style_home_intro"
			text_color="#color_text_secondary"
			text_font="font_inter_regular_14"
			text_align="center"
		/>
		<style
			name="style_home_hint"
			bg_color="#color_dark_panel"
			bg_opa="100%"
			radius="#radius_default"
			pad_all="16"
			border_width="0"
			outline_width="0"
			shadow_width="0"
		/>
		<style
			name="style_home_hint_text"
			text_color="#color_text_on_card"
			text_font="font_inter_regular_14"
			text_align="center"
		/>
		<style name="style_home_hint_accent" text_color="#color_accent" text_font="font_inter_semi_bold_14" />
		<style
			name="style_home_status_dot"
			bg_color="#color_status_ok"
			bg_opa="100%"
			radius="100%"
			width="12"
			height="12"
		/>
		<style
			name="style_home_status_text"
			text_color="#color_text_secondary"
			text_font="font_inter_regular_10"
			text_align="center"
		/>
	</styles>

	<view extends="lv_obj" width="480" height="480" flex_flow="column" scrollable="false">
		<style name="style_home_root" />

		<status_bar width="480" height="48" />

		<column
			name="home_content"
			width="100%"
			grow="1"
			gap="24"
			pad="0"
			horizontal_align="center"
			vertical_align="center"
		>
			<style name="style_home_content" />

			<lv_image src="logo_light_for_dark" width="249" height="58" inner_align="center">
				<style name="style_home_logo" />
			</lv_image>

			<column width="100%" gap="8" pad="0" horizontal_align="center">
				<lv_label text="Sistem Triase Cerdas" width="100%">
					<style name="style_home_subtitle" />
				</lv_label>
				<lv_label text="Siap untuk memulai triase pasien bencana" width="100%">
					<style name="style_home_intro" />
				</lv_label>
			</column>

			<lv_obj
				flex_flow="row"
				style_flex_main_place="center"
				style_flex_cross_place="center"
				height="48"
				width="380"
			>
				<style name="style_home_hint" />
				<lv_spangroup width="100%" style_text_align="center">
					<lv_spangroup-span text="Tekan " style="style_home_hint_text" />
					<lv_spangroup-span text="SCAN" style="style_home_hint_accent" />
					<lv_spangroup-span text=" untuk memindai gelang RFID pasien" style="style_home_hint_text" />
				</lv_spangroup>
			</lv_obj>

			<row gap="16" pad="0" horizontal_align="center" vertical_align="start" style_margin_top="32">
				<column gap="6" pad="0" horizontal_align="center">
					<lv_obj>
						<style name="style_home_status_dot" />
					</lv_obj>
					<lv_label text="Sistem OK" width="50" height="15">
						<style name="style_home_status_text" />
					</lv_label>
				</column>
				<column gap="6" pad="0" horizontal_align="center">
					<lv_obj>
						<style name="style_home_status_dot" />
					</lv_obj>
					<lv_label text="Sensor OK" width="51" height="15">
						<style name="style_home_status_text" />
					</lv_label>
				</column>
				<column gap="6" pad="0" horizontal_align="center">
					<lv_obj>
						<style name="style_home_status_dot" />
					</lv_obj>
					<lv_label text="LoRa OK" width="42" height="15">
						<style name="style_home_status_text" />
					</lv_label>
				</column>
			</row>
		</column>

		<button_bar
			width="480"
			height="71"
			label1="Scan"
			icon1="icon_search"
			label2="Power"
			icon2="icon_power"
			color2="#color_danger"
			label3="Menu"
			icon3="icon_menu"
		/>
	</view>
</screen>
