<screen permanent="true">
	<styles>
		<style
			name="style_test_root"
			bg_color="#color_dark_bg"
			bg_opa="100%"
			text_color="#color_dark_text"
			pad_all="0"
			pad_gap="0"
		/>
		<style
			name="style_test_title"
			text_color="#color_dark_text"
			text_font="font_inter_semi_bold_18"
			text_align="center"
		/>
		<style name="style_test_hint" text_color="#color_text_secondary" text_font="font_inter_regular_12" />
		<style
			name="style_test_row"
			width="100%"
			bg_color="#color_dark_panel"
			bg_opa="100%"
			radius="#radius_default"
			border_width="0"
			outline_width="0"
			shadow_width="0"
		/>
		<style name="style_test_label" text_color="#color_text_on_card" text_font="font_inter_regular_14" />
		<!-- Monospace would be the honest choice for a number that changes every
		     second, but no mono font is exported; semibold keeps the digits from
		     looking like body text at least. -->
		<style name="style_test_value" text_color="#color_dark_text" text_font="font_inter_semi_bold_20" />
		<style
			name="style_test_dot"
			bg_color="#color_status_ok"
			bg_opa="100%"
			radius="100%"
			width="12"
			height="12"
		/>
		<style name="style_test_alive" text_color="#color_status_ok" text_font="font_inter_semi_bold_16" />
	</styles>

	<view extends="lv_obj" width="480" height="480" flex_flow="column" scrollable="false">
		<style name="style_test_root" />

		<status_bar width="480" height="48" />

		<!-- style_pad_* and not a <style>: <column> writes pad_all=0 as a LOCAL
		     style, and a local property beats every added style in LVGL's cascade,
		     so a style-borne pad here silently does nothing and the cards run edge
		     to edge. (The same trap the other screens' *_content styles are in.) -->
		<column
			name="content"
			width="100%"
			height="361"
			gap="10"
			pad="0"
			style_pad_hor="20"
			style_pad_ver="12"
			horizontal_align="center"
			vertical_align="start"
			scrollable="false"
		>

			<lv_label text="Uji Jangkauan" width="100%" style_margin_bottom="4">
				<style name="style_test_title" />
			</lv_label>

			<!-- The link row first: it is the one an operator walking away from the
			     station is watching, and it is the one that goes red. -->
			<row
				width="100%"
				height="content"
				gap="8"
				pad="16"
				horizontal_align="space_between"
				vertical_align="center"
			>
				<style name="style_test_row" />
				<row width="content" height="content" gap="8" pad="0" vertical_align="center">
					<lv_obj name="test_alive_dot">
						<style name="style_test_dot" />
					</lv_obj>
					<lv_label name="test_alive" text="LINK --">
						<style name="style_test_alive" />
					</lv_label>
				</row>
				<lv_label name="test_rssi" text="-- dBm">
					<style name="style_test_value" />
				</lv_label>
			</row>

			<row
				width="100%"
				height="content"
				gap="8"
				pad="16"
				horizontal_align="space_between"
				vertical_align="center"
			>
				<style name="style_test_row" />
				<lv_label text="Baterai">
					<style name="style_test_label" />
				</lv_label>
				<lv_label name="test_battery" text="--% / --,-- V">
					<style name="style_test_value" />
				</lv_label>
			</row>

			<row
				width="100%"
				height="content"
				gap="8"
				pad="16"
				horizontal_align="space_between"
				vertical_align="center"
			>
				<style name="style_test_row" />
				<lv_label text="Poll STM32 ok">
					<style name="style_test_label" />
				</lv_label>
				<lv_label name="test_polls_ok" text="--">
					<style name="style_test_value" />
				</lv_label>
			</row>

			<row
				width="100%"
				height="content"
				gap="8"
				pad="16"
				horizontal_align="space_between"
				vertical_align="center"
			>
				<style name="style_test_row" />
				<lv_label text="Poll STM32 gagal">
					<style name="style_test_label" />
				</lv_label>
				<lv_label name="test_polls_failed" text="--">
					<style name="style_test_value" />
				</lv_label>
			</row>

			<!-- Says what the numbers are NOT: the LoRa packet counters live on the
			     STM32 and no register publishes them, so nothing here can show
			     transmitted/acked packets. RSSI is the downlink the node heard. -->
			<lv_label
				text="RSSI = poll terakhir dari stasiun. Poll = link I2C ke STM32, bukan paket LoRa."
				width="100%"
				long_mode="wrap"
				style_margin_top="2"
			>
				<style name="style_test_hint" />
			</lv_label>
		</column>

		<button_bar
			width="480"
			height="71"
			label0="Back"
			icon0="icon_arrow_left"
			label2="Power"
			icon2="icon_power"
			color2="#color_danger"
			label3="Menu"
			icon3="icon_menu"
		/>
	</view>
</screen>
