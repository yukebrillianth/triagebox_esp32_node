# Normalize line endings in the repo. Without this a Windows clone rewrites
# every file to CRLF and `git diff` reports the whole tree as changed (549 files
# / 71k lines, all whitespace) — which makes any real diff unreviewable.
#
# `text=auto` stores LF in the repo and checks out the platform's native ending.
# The exceptions below force LF even on Windows, because CRLF actually breaks
# them: `sh` refuses a script whose shebang line ends in \r ("Illegal option -").
* text=auto

*.sh text eol=lf
*.py text eol=lf

# Keep C/CMake/docs as LF in the repo; editors on every platform handle it.
*.c text
*.h text
*.cpp text
*.hpp text
*.cmake text
CMakeLists.txt text
*.md text
*.txt text
*.yml text
*.yaml text
*.json text
*.xml text
*.csv text
*.defaults text
Kconfig text
Kconfig.projbuild text
.gitignore text
.gitattributes text

# Binary: never touch these, and do not try to diff them as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.bin binary
*.elf binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary
